{
    "repository": "https://github.com/Naxesss/MapsetVerifier",
    "locations": {
        "checks-metadata-script": "/scripts/export-checks-metadata.sh",
        "assets-checks": "/electron-app/public/assets",
        "assets-changelog": "/electron-app/public/changelog",
        "changelogs": "/electron-app/src/content/changelog"
    },
    "destinations": {
        "checks-metadata": "app/data/checks-metadata.json",
        "assets-checks": "public/assets",
        "assets-changelog": "public/changelog",
        "changelogs": "app/data/changelogs"
    }
}
